#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Build all tap bottles in a clean container on the native host.
set -euo pipefail
if (($# != 2)); then
  echo "Usage: $0 RELEASE_TAG OUTPUT_DIRECTORY" >&2
  exit 2
fi
release_tag=$1
[[ $release_tag =~ ^[[:alnum:]][[:alnum:]._-]*$ ]]
root=$(git -C "$(dirname "$0")/.." rev-parse --show-toplevel)
if [[ -n $(git -C "$root" status --porcelain --untracked-files=no) ]]; then
  echo 'Commit tracked changes before building release bottles.' >&2
  exit 1
fi
case $(uname -m) in
  x86_64)
    image=ghcr.io/homebrew/brew@sha256:293264ba0b0ff18b0e1f265e965e1e501819cf138dd8ce16fcfb5b5e099e2b13
    ;;
  aarch64)
    image=ghcr.io/homebrew/brew@sha256:ab874526c131ca2b2e84906f2dde8d273b510a80f48db94bce35404259e6e388
    ;;
  *) echo 'A native Linux ARM64 or AMD64 host is required.' >&2; exit 1 ;;
esac
mkdir -p "$2"
output=$(cd "$2" && pwd)
if [[ -n $(ls -A "$output") ]]; then
  echo 'Use an empty output directory for each build.' >&2
  exit 1
fi
printf '%s\n' "$image" > "$output/build-image.txt"
git -C "$root" rev-parse HEAD > "$output/tap-commit.txt"
docker run --rm \
  --mount "type=bind,src=$root,dst=/tap,readonly" \
  --mount "type=bind,src=$output,dst=/output" \
  -e "EXPECTED_ARCH=$(uname -m)" \
  -e "BOTTLE_ROOT_URL=https://github.com/tpurtell/local-ai-tap/releases/download/$release_tag" \
  -e HOMEBREW_NO_AUTO_UPDATE=1 -e HOMEBREW_NO_INSTALL_CLEANUP=1 \
  -e HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK=1 -e HOMEBREW_NO_ASK=1 \
  -e HOMEBREW_MAKE_JOBS=8 \
  "$image" bash /tap/scripts/build-bottles-container
