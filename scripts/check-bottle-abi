#!/usr/bin/env python3
"""Check every ELF file in installed tap packages against glibc 2.39.

SPDX-License-Identifier: MIT
"""
from pathlib import Path
import re
import subprocess
import sys

for name in sys.argv[1:]:
    prefix = Path(subprocess.check_output(["brew", "--prefix", name], text=True).strip())
    versions = set()
    count = 0
    for path in prefix.rglob("*"):
        if not path.is_file() or path.is_symlink():
            continue
        with path.open("rb") as stream:
            if stream.read(4) != b"\x7fELF":
                continue
        count += 1
        symbols = subprocess.check_output(["readelf", "--version-info", str(path)], text=True)
        for version in re.findall(r"Name: GLIBC_([0-9.]+)", symbols):
            assert tuple(map(int, version.split("."))) <= (2, 39), f"{path}: GLIBC_{version} exceeds 2.39"
            versions.add(version)
    if not count and name == "tpurtell/local-ai/gpu-powerd-webui":
        # This package intentionally contains Python, shell and static assets only.
        app = prefix / "share/gpu-powerd-webui"
        assert all((app / f).is_file() for f in ("server.py", "app.js", "index.html"))
        print(f"PASS {name}: Python and static assets only; no ELF ABI requirements")
        continue
    assert count, f"No ELF files checked for {name}"
    maximum = max(versions, key=lambda v: tuple(map(int, v.split("."))))
    print(f"PASS {name}: {count} ELF files, maximum required GLIBC_{maximum}")
